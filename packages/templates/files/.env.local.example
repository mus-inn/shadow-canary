# Vercel API (for admin dashboard)
VERCEL_API_TOKEN=
VERCEL_ORG_ID=
VERCEL_EDGE_CONFIG_ID=

# Admin dashboard auth
ADMIN_USER=admin
ADMIN_PASS=change-me
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32

# Local dev only — Vercel auto-injects this in every deploy. The middleware
# derives the Edge Config key from it as `shadow-<slug>-canary`. Set it to
# your GitHub repo name (e.g. `my-app` for `owner/my-app`) so local dev
# reads/writes the same key as production. Without it, middleware passes
# through in dev with a one-time warn (so next dev stays usable), but prod
# throws.
VERCEL_GIT_REPO_SLUG=

# Optional: Slack notifications (used by GH Actions, not app)
# SLACK_WEBHOOK_URL=

# Vercel Cron — required for /api/canary-tick (auto-injected by Vercel in
# deployed envs; set locally only if you want to call /api/canary-tick by
# hand). Vercel signs cron requests with `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# Required for /api/canary-tick → /api/slo handshake. The cron forwards this
# bearer to the SLO endpoint on the new prod deploy. The SLO route on the
# host project must read the same value and constant-time compare.
SLO_AUTH_TOKEN=

# Optional: bypass Vercel deployment protection on /api/slo calls when the
# new prod alias is behind protection. Auto-injected by Vercel; set
# explicitly only if you run /api/canary-tick locally against a protected
# deploy.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: Slack webhook for canary-tick promote / rollback notifications.
# When unset, /api/canary-tick is silent on those events.
# SLACK_WEBHOOK_URL_MONITORING_CHANNEL=
