{
  "name": "@dotworld/shadow-canary-templates",
  "version": "0.8.0",
  "description": "File payload for shadow-canary, copyable into Next.js projects",
  "type": "module",
  "bin": {
    "shadow-canary-copy": "./bin/copy.js"
  },
  "files": [
    "bin",
    "files",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dotworld/shadow-canary-core": "workspace:^",
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5.6",
    "vitest": "^2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mus-inn/shadow-canary.git",
    "directory": "packages/templates"
  },
  "license": "MIT"
}
